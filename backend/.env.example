# =============================================================================
# Farmer Voice AI Assistant Environment Configuration
# =============================================================================

# Django Security
DJANGO_SECRET_KEY=django-insecure-production-ready-farmer-voice-ai-key-change-in-prod
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# Local Ollama / LLM Configuration
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

# Speech Processing (Faster-Whisper & Edge-TTS)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Vector DB & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=vector_db/knowledge.index

# CORS / Frontend Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:3000,http://127.0.0.1:8000
