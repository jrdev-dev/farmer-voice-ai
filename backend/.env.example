# Farmer Voice AI - Environment Configuration Template

# Optional Free Cloud LLM APIs for Instant 0.3s Inference Speed:
# 1. Groq Cloud API Key (Get free key from https://console.groq.com):
GROQ_API_KEY=gsk_your_free_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API Key (Get free key from https://ai.google.dev):
GEMINI_API_KEY=AIzaSy_your_free_gemini_key_here

# 3. Local Ollama Fallback Settings:
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TIMEOUT=180
